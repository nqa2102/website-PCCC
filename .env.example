# Biến môi trường cho Vercel (Settings → Environment Variables). Không commit giá trị thật.

# Neon PostgreSQL (bắt buộc)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.neon.tech/neondb?sslmode=require"

# Khóa ký phiên đăng nhập quản trị, chuỗi ngẫu nhiên >= 32 ký tự (bắt buộc)
ADMIN_SESSION_SECRET="CHUOI_NGAU_NHIEN_DAI"

# Vercel Blob: tải ảnh/PDF từ trang quản trị. Tự thêm khi kết nối Blob store với dự án.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# Email nhận thông báo khi có khách gửi yêu cầu (mặc định: hung061195@gmail.com)
NOTIFICATION_EMAIL="hung061195@gmail.com"

# CÁCH 1: Dùng Resend API (Khuyên dùng cho serverless)
RESEND_API_KEY="re_xxx"
# Địa chỉ gửi (vd: "APEX Website <thongbao@apexhome.vn>" sau khi verify domain trên Resend, hoặc "APEX Website <onboarding@resend.dev>")
RESEND_FROM="APEX Website <onboarding@resend.dev>"

# CÁCH 2: Dùng Gmail SMTP với Mật khẩu ứng dụng (App Password 16 chữ cái)
# Bật xác thực 2 bước trên Gmail -> Tạo Mật khẩu ứng dụng tại https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="hung061195@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"

# Đo lường quảng cáo (ID công khai, có thể để trống phần chưa dùng). Chỉ tải sau khi khách đồng ý cookie.
VITE_GA4_ID="G-XXXXXXXXXX"
VITE_GOOGLE_ADS_ID="AW-XXXXXXXXX"
VITE_GOOGLE_ADS_LEAD_LABEL="NhanChuyenDoi"
VITE_META_PIXEL_ID="000000000000000"
# Google Tag Manager: giao cho đơn vị chạy quảng cáo tự gắn thẻ (sự kiện: apex_page_view, generate_lead, contact_click)
VITE_GTM_ID="GTM-XXXXXXX"
