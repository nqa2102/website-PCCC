# Biến môi trường cho Vercel (Settings → Environment Variables). Không commit giá trị thật.

# Neon PostgreSQL (bắt buộc)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.neon.tech/neondb?sslmode=require"

# Khóa ký phiên đăng nhập quản trị, chuỗi ngẫu nhiên >= 32 ký tự (bắt buộc)
ADMIN_SESSION_SECRET="CHUOI_NGAU_NHIEN_DAI"

# Vercel Blob: tải ảnh/PDF từ trang quản trị. Tự thêm khi kết nối Blob store với dự án.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# Resend: email thông báo khi có khách gửi yêu cầu (tùy chọn)
RESEND_API_KEY="re_xxx"
NOTIFICATION_EMAIL="contact@apexdoor.net"
# Địa chỉ gửi, phải thuộc tên miền đã xác thực trên Resend (apexdoor.net)
RESEND_FROM="APEX Website <thongbao@apexdoor.net>"

# Đo lường quảng cáo (ID công khai, có thể để trống phần chưa dùng). Chỉ tải sau khi khách đồng ý cookie.
VITE_GA4_ID="G-XXXXXXXXXX"
VITE_GOOGLE_ADS_ID="AW-XXXXXXXXX"
VITE_GOOGLE_ADS_LEAD_LABEL="NhanChuyenDoi"
VITE_META_PIXEL_ID="000000000000000"
